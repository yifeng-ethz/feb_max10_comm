<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Mu3e</vendor>
  <vendorID>MU3E</vendorID>
  <name>MU3E_MAX10_PROG_AVMM</name>
  <series>MU3E_FPGA_IP</series>
  <version>0.2.0</version>
  <description>CMSIS-SVD description of the max10_prog_avmm control aperture. BaseAddress is 0 because this file describes the relative CSR aperture of the IP; system integration supplies the live slave base address.</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>MAX10_PROG_AVMM_CSR</name>
      <description>Relative CSR aperture for standard-AVMM MAX10 page programming. The sparse gaps between LAST_ERROR and PAGE_DATA are reserved.</description>
      <groupName>MU3E_MAX10_PROG</groupName>
      <baseAddress>0x0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>ID</name>
          <description>IP identifier magic. Default Rev-A value is ASCII &quot;M10P&quot;.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <resetValue>0x4D313050</resetValue>
          <fields>
            <field>
              <name>value</name>
              <description>Packed ASCII identifier.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>VERSION</name>
          <description>Packed interface version: [31:24]=major, [23:16]=minor, [15:12]=patch, [11:0]=build.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>major</name>
              <description>Major version.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>minor</name>
              <description>Minor version.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>patch</name>
              <description>Patch version.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>build</name>
              <description>Build provenance; not part of the software ABI.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>Common management control.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>sw_reset</name>
              <description>Soft reset pulse.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, write zero.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Common ready/busy/fault/resetting summary.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ready</name>
              <description>IP is CSR-accessible and not held in software reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>busy</name>
              <description>At least one local programming operation is in flight.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>fault</name>
              <description>Sticky summary: ERR_FLAGS != 0.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>resetting</name>
              <description>Software reset is in progress.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ERR_FLAGS</name>
          <description>Sticky local error flags.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>start_while_busy</name>
              <description>START requested while busy.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>start_during_reset</name>
              <description>START requested during software reset.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>addr_missing</name>
              <description>START requested before FLASH_ADDR was valid.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>xfer_bytes_zero</name>
              <description>XFER_BYTES was zero at START time.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>xfer_bytes_gt_256</name>
              <description>XFER_BYTES exceeded 256 at START time.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>page_underrun</name>
              <description>Not enough contiguous page data was staged.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>link_timeout</name>
              <description>Downstream Arria/MAX10 link timed out.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>max10_timeout</name>
              <description>MAX10 reported timeout.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>max10_crcerror</name>
              <description>MAX10 reported CRC error.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>max10_nstatus_low</name>
              <description>MAX10 reported NSTATUS low.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ERR_COUNT</name>
          <description>Saturating count of newly-detected error events.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Error event count.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SCRATCH</name>
          <description>Diagnostic scratch register with no side effects.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>value</name>
              <description>Scratch value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLASH_ADDR</name>
          <description>Absolute SPI flash byte address for the next page launch.</description>
          <addressOffset>0x01C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>flash_addr</name>
              <description>Absolute flash byte address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, write zero.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>XFER_BYTES</name>
          <description>Number of valid payload bytes for the next START request. Reset default is 256.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000100</resetValue>
          <fields>
            <field>
              <name>xfer_bytes</name>
              <description>Valid payload byte count, legal range 1..256.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, write zero.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PROG_CTRL</name>
          <description>Write-one pulse programming commands. Reads are not meaningful and should be avoided.</description>
          <addressOffset>0x024</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>start</name>
              <description>Launch one programming transaction.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>clear_page</name>
              <description>Clear the page aperture and staged-word count.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>clear_status</name>
              <description>Clear LAST_ERROR and sticky programming status.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>clear_addr</name>
              <description>Clear the local address-valid latch and zero FLASH_ADDR.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, write zero.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PROG_STATUS</name>
          <description>Programming engine status and mirrored MAX10 status summary.</description>
          <addressOffset>0x028</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ready</name>
              <description>Local engine is idle and launch-eligible.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>busy</name>
              <description>Programming launch is in progress.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>page_ready</name>
              <description>Enough contiguous page data is staged for the current XFER_BYTES.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>addr_valid</name>
              <description>FLASH_ADDR has been written since reset or clear.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>len_valid</name>
              <description>XFER_BYTES is in the legal range 1..256.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>cdc_busy</name>
              <description>Metadata or payload handoff across domains is in progress.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>launch_accepted</name>
              <description>Sticky until clear_status; most recent START was accepted.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>launch_done</name>
              <description>Sticky until clear_status; most recent accepted START finished.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_arriawriting</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[0].</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_spi_busy</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[1].</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_fifo_empty</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[14].</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_fifo_full</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[15].</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_conf_done</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[16].</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_nstatus</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[17].</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_timeout</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[18].</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>max10_crcerror</name>
              <description>Raw mirror of MAX10 PROGRAMMING_STATUS[19].</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>engine_state</name>
              <description>Implementation-defined local debug state.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STAGED_WORDS</name>
          <description>Number of contiguous valid words staged from PAGE_DATA[0].</description>
          <addressOffset>0x02C</addressOffset>
